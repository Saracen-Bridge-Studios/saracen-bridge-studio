<FinalDraft DocumentType="Script" Template="No" Version="5">
<Content>
<Paragraph Type="Scene Heading"><Text>INT. RADIO ROOM - NIGHT</Text></Paragraph>
<Paragraph Type="Action"><Text>Static. ELSIE leans into the microphone.</Text></Paragraph>
<Paragraph Type="Character"><Text>ELSIE</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Keeper, come in.</Text></Paragraph>
<Paragraph Type="Character"><Text>TOM (V.O.)</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Lamp's lit.</Text></Paragraph>
<Paragraph Type="Scene Heading"><Text>EXT. ROCKS - NIGHT</Text></Paragraph>
<Paragraph Type="Action"><Text>A hull scrapes stone.</Text></Paragraph>
</Content>
<TitlePage><Content><Paragraph><Text>Radio Night</Text></Paragraph></Content></TitlePage>
</FinalDraft>
