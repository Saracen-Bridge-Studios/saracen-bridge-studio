<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Studio's window (Contents/Helpers/Saracen Bridge Studio.app). build_mac.sh fills in @VERSION@. -->
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>studio-window</string>
    <key>CFBundleIdentifier</key><string>com.saracenbridge.studio.window</string>
    <key>CFBundleName</key><string>Saracen Bridge Studio</string>
    <key>CFBundleDisplayName</key><string>Saracen Bridge Studio</string>
    <key>CFBundleIconFile</key><string>studio.icns</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>@VERSION@</string>
    <key>CFBundleVersion</key><string>@VERSION@</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>LSMinimumSystemVersion</key><string>13.0</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSRequiresAquaSystemAppearance</key><false/>
    <key>NSMicrophoneUsageDescription</key><string>Saracen Bridge Studio uses the microphone for huddles and meetings in the Room.</string>
    <key>NSLocalNetworkUsageDescription</key><string>Saracen Bridge Studio connects to the productions your team hosts on their computers.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- The window shows the Studio's own page on this computer and calls the team's hosts on the local network. -->
        <key>NSAllowsLocalNetworking</key><true/>
        <key>NSAllowsArbitraryLoadsInWebContent</key><true/>
    </dict>
</dict>
</plist>
