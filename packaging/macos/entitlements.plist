<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The launcher (Python engine) under the hardened runtime that notarization requires. Python's ctypes callbacks
     need writable-executable memory; the Room's huddles need the microphone. Not sandboxed: the Studio hosts its
     own productions (it listens for the team) and runs the AI engine, call server and OCR beside it. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
